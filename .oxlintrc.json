{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts"
  ],
  "plugins": [
    "import",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest",
    "oxc"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "browser": true,
    "builtin": true,
    "node": true
  }
}
