{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtendDeliveryEntitlementRequest",
  "type": "object",
  "required": [
    "expected_version",
    "extend_days"
  ],
  "properties": {
    "expected_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "extend_days": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}