{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageBreakdownResponse",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UsageBreakdownRow"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "MonetaryAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "UsageBreakdownRow": {
      "type": "object",
      "required": [
        "billable_price",
        "bucket",
        "cached_input_tokens",
        "input_tokens",
        "output_tokens",
        "provider_cost"
      ],
      "properties": {
        "billable_price": {
          "$ref": "#/definitions/MonetaryAmount"
        },
        "bucket": {
          "type": "string"
        },
        "cached_input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "model_alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "provider_cost": {
          "$ref": "#/definitions/MonetaryAmount"
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}