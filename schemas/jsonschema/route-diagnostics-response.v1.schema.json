  "properties": {
    "active_snapshot": {
      "anyOf": [
        {
          "$ref": "#/definitions/ConfigSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_snapshot_matches_route_policy": {
      "type": "boolean"
    },
    "last_route_receipt": {
      "anyOf": [
        {
          "$ref": "#/definitions/RouteReceiptSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "recent_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RouteReceiptSummary"
      }
