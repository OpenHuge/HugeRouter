{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteDiagnosticsResponse",
  "type": "object",
  "required": [
    "active_snapshot_matches_route_policy",
    "recent_receipts",
    "route_policy",
    "targets"
