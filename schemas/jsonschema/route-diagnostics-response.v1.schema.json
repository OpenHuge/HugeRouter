      "properties": {
        "admission_result": {
          "$ref": "#/definitions/AdmissionResult"
        },
        "created_at": {
          "type": "string"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_receipt_id": {
          "$ref": "#/definitions/RouteReceiptId"
        },
        "selected_target": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderResourceId"
            },
            {
              "type": "null"
            }
          ]
