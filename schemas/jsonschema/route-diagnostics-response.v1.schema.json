        "updated_at": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ProviderResourceId": {
      "type": "string"
    },
    "ProviderResourceStatus": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "draining",
        "quarantined",
        "deleted"
      ]
    },
    "RouteDiagnosticDecision": {
      "type": "string",
      "enum": [
        "selected",
        "eligible",
        "excluded"
      ]
