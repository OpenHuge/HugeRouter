    "CredentialOwnerType": {
      "type": "string",
      "enum": [
        "platform",
        "tenant",
        "project",
        "partner"
      ]
    },
    "DeploymentScope": {
      "type": "string",
      "enum": [
        "shared",
        "tenant_dedicated",
        "project_dedicated"
      ]
