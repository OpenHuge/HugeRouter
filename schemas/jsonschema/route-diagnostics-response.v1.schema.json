      "properties": {
        "created_at": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "model_alias": {
          "type": "string"
        },
        "preferred_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_family": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_policy_id": {
          "$ref": "#/definitions/RoutePolicyId"
        },
        "tenant_id": {
          "$ref": "#/definitions/TenantId"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
