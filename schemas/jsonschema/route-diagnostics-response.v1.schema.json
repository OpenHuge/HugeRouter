        "capabilities": {
          "$ref": "#/definitions/ProviderCapabilities"
        },
        "created_at": {
          "type": "string"
        },
        "credential_owner_type": {
          "$ref": "#/definitions/CredentialOwnerType"
        },
        "deployment_scope": {
          "$ref": "#/definitions/DeploymentScope"
        },
        "endpoint_base_url": {
          "type": "string"
        },
        "health_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_state": {
          "$ref": "#/definitions/HealthState"
        },
        "is_transit_gateway": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance_class": {
          "$ref": "#/definitions/ProvenanceClass"
        },
        "provider_id": {
          "type": "string"
        },
        "provider_resource_id": {
          "$ref": "#/definitions/ProviderResourceId"
        },
        "quarantine_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ProviderResourceStatus"
        },
        "supported_protocol_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tenant_id": {
          "$ref": "#/definitions/TenantId"
