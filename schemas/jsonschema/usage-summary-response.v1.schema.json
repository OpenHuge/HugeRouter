{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageSummaryResponse",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "$ref": "#/definitions/UsageSummary"
    }
  },
  "definitions": {
    "MonetaryAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "ProjectId": {
      "type": "string"
    },
    "TenantId": {
      "type": "string"
    },
    "UsageSummary": {
      "type": "object",
      "required": [
        "billable_price",
        "cached_input_tokens",
        "currency",
        "event_count",
        "input_tokens",
        "output_tokens",
        "provider_cost",
        "tenant_id",
        "window_end",
        "window_start"
      ],
      "properties": {
        "billable_price": {
          "$ref": "#/definitions/MonetaryAmount"
        },
        "cached_input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "currency": {
          "type": "string"
        },
        "event_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "owner_account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_cost": {
          "$ref": "#/definitions/MonetaryAmount"
        },
        "tenant_id": {
          "$ref": "#/definitions/TenantId"
        },
        "window_end": {
          "type": "string"
        },
        "window_start": {
          "type": "string"
        }
      }
    }
  }
}