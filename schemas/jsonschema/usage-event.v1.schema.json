{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageEvent",
  "type": "object",
  "required": [
    "estimated_cost",
    "idempotency_key",
    "model_alias",
    "phase",
    "project_id",
    "provider_resource_id",
    "recorded_at",
    "route_receipt_id",
    "tenant_id",
    "usage",
    "usage_event_id"
  ],
  "properties": {
    "estimated_cost": {
      "$ref": "#/definitions/MonetaryAmount"
    },
    "grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "model_alias": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/definitions/UsagePhase"
    },
    "project_id": {
      "$ref": "#/definitions/ProjectId"
    },
    "provider_resource_id": {
      "$ref": "#/definitions/ProviderResourceId"
    },
    "recorded_at": {
      "type": "string"
    },
    "route_receipt_id": {
      "$ref": "#/definitions/RouteReceiptId"
    },
    "tenant_id": {
      "$ref": "#/definitions/TenantId"
    },
    "usage": {
      "$ref": "#/definitions/UsageMetrics"
    },
    "usage_event_id": {
      "$ref": "#/definitions/UsageEventId"
    }
  },
  "definitions": {
    "MonetaryAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "ProjectId": {
      "type": "string"
    },
    "ProviderResourceId": {
      "type": "string"
    },
    "RouteReceiptId": {
      "type": "string"
    },
    "TenantId": {
      "type": "string"
    },
    "UsageEventId": {
      "type": "string"
    },
    "UsageMetrics": {
      "type": "object",
      "required": [
        "cached_input_tokens",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "cached_input_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "UsagePhase": {
      "type": "string",
      "enum": [
        "reserve",
        "partial",
        "final",
        "release"
      ]
    }
  }
}