{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteSimulationResponse",
  "type": "object",
  "required": [
    "admission_result",
    "config_snapshot_id",
    "eligible_candidates",
    "estimated_cost",
    "excluded_candidates",
    "simulation_id"
  ],
  "properties": {
    "admission_result": {
      "$ref": "#/definitions/AdmissionResult"
    },
    "config_snapshot_id": {
      "$ref": "#/definitions/ConfigSnapshotId"
    },
    "eligible_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EligibleCandidate"
      }
    },
    "estimated_cost": {
      "$ref": "#/definitions/MonetaryAmount"
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExcludedTarget"
      }
    },
    "selected_target": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProviderResourceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulation_id": {
      "type": "string"
    }
  },
  "definitions": {
    "AdmissionResult": {
      "type": "string",
      "enum": [
        "admitted",
        "rejected_budget",
        "rejected_rate_limit",
        "rejected_concurrency",
        "rejected_policy",
        "rejected_no_candidate"
      ]
    },
    "ConfigSnapshotId": {
      "type": "string"
    },
    "EligibleCandidate": {
      "type": "object",
      "required": [
        "provider_resource_id",
        "score_breakdown"
      ],
      "properties": {
        "provider_resource_id": {
          "$ref": "#/definitions/ProviderResourceId"
        },
        "score_breakdown": {
          "$ref": "#/definitions/ScoreBreakdown"
        }
      }
    },
    "ExcludedTarget": {
      "type": "object",
      "required": [
        "provider_resource_id",
        "reason"
      ],
      "properties": {
        "provider_resource_id": {
          "$ref": "#/definitions/ProviderResourceId"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "MonetaryAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "ProviderResourceId": {
      "type": "string"
    },
    "ScoreBreakdown": {
      "type": "object",
      "required": [
        "cost",
        "health",
        "latency",
        "trust"
      ],
      "properties": {
        "cost": {
          "type": "number",
          "format": "float"
        },
        "health": {
          "type": "number",
          "format": "float"
        },
        "latency": {
          "type": "number",
          "format": "float"
        },
        "trust": {
          "type": "number",
          "format": "float"
        }
      }
    }
  }
}