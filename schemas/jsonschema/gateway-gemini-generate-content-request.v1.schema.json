{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewayGeminiGenerateContentRequest",
  "type": "object",
  "required": [
    "contents",
    "model"
  ],
  "properties": {
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GatewayGeminiContent"
      }
    },
    "generationConfig": {
      "anyOf": [
        {
          "$ref": "#/definitions/GatewayGeminiGenerationConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": "string"
    },
    "stream": {
      "default": false,
      "type": "boolean"
    },
    "systemInstruction": {
      "anyOf": [
        {
          "$ref": "#/definitions/GatewayGeminiSystemInstruction"
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": true
    }
  },
  "definitions": {
    "GatewayGeminiContent": {
      "type": "object",
      "required": [
        "parts",
        "role"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GatewayGeminiPart"
          }
        },
        "role": {
          "$ref": "#/definitions/GatewayGeminiRole"
        }
      }
    },
    "GatewayGeminiGenerationConfig": {
      "type": "object",
      "properties": {
        "maxOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "temperature": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      }
    },
    "GatewayGeminiPart": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "GatewayGeminiRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "model",
        "system"
      ]
    },
    "GatewayGeminiSystemInstruction": {
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GatewayGeminiPart"
          }
        }
      }
    }
  }
}