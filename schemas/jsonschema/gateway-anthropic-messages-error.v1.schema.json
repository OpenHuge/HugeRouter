{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewayAnthropicMessagesError",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "$ref": "#/definitions/NormalizedError"
    }
  },
  "definitions": {
    "NormalizedError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "request_id",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "upstream_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_status_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "validation_issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ValidationIssue"
          }
        }
      }
    },
    "ValidationIssue": {
      "type": "object",
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}