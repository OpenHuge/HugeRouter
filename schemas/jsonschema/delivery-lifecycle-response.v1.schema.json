{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliveryLifecycleResponse",
  "type": "object",
  "required": [
    "entitlement",
    "events",
    "segments"
  ],
  "properties": {
    "entitlement": {
      "$ref": "#/definitions/DeliveryEntitlement"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeliveryLifecycleEvent"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeliveryServiceSegment"
      }
    }
  },
  "definitions": {
    "DeliveryEntitlement": {
      "type": "object",
      "required": [
        "created_at",
        "delivery_id",
        "ends_at",
        "entitlement_id",
        "service_days",
        "service_ends_at",
        "service_kind",
        "service_starts_at",
        "starts_at",
        "status",
        "updated_at",
        "version"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "delivery_id": {
          "type": "string"
        },
        "ends_at": {
          "type": "string"
        },
        "entitlement_id": {
          "type": "string"
        },
        "service_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "service_ends_at": {
          "type": "string"
        },
        "service_kind": {
          "type": "string"
        },
        "service_starts_at": {
          "type": "string"
        },
        "starts_at": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "DeliveryLifecycleEvent": {
      "type": "object",
      "required": [
        "created_at",
        "created_by",
        "entitlement_id",
        "event_id",
        "event_type",
        "status"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "entitlement_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "payload": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      }
    },
    "DeliveryServiceSegment": {
      "type": "object",
      "required": [
        "activation_id",
        "artifact_id",
        "carrier_valid_until",
        "created_at",
        "created_by",
        "delivery_id",
        "effective_from",
        "effective_until",
        "entitlement_id",
        "project_id",
        "provider",
        "segment_id",
        "segment_index",
        "status",
        "tenant_id",
        "updated_at",
        "version"
      ],
      "properties": {
        "activation_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "carrier_valid_until": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "delivery_id": {
          "type": "string"
        },
        "effective_from": {
          "type": "string"
        },
        "effective_until": {
          "type": "string"
        },
        "entitlement_id": {
          "type": "string"
        },
        "project_id": {
          "$ref": "#/definitions/ProjectId"
        },
        "provider": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "segment_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "status": {
          "type": "string"
        },
        "tenant_id": {
          "$ref": "#/definitions/TenantId"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ProjectId": {
      "type": "string"
    },
    "TenantId": {
      "type": "string"
    }
  }
}