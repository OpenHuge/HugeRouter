{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewayGeminiGenerateContentResponse",
  "type": "object",
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GatewayGeminiCandidate"
      }
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "responseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "usageMetadata": {
      "anyOf": [
        {
          "$ref": "#/definitions/GatewayGeminiUsageMetadata"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "GatewayGeminiCandidate": {
      "type": "object",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/definitions/GatewayGeminiContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GatewayGeminiContent": {
      "type": "object",
      "required": [
        "parts",
        "role"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GatewayGeminiPart"
          }
        },
        "role": {
          "$ref": "#/definitions/GatewayGeminiRole"
        }
      }
    },
    "GatewayGeminiPart": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "GatewayGeminiRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "model",
        "system"
      ]
    },
    "GatewayGeminiUsageMetadata": {
      "type": "object",
      "required": [
        "cachedContentTokenCount",
        "candidatesTokenCount",
        "promptTokenCount",
        "totalTokenCount"
      ],
      "properties": {
        "cachedContentTokenCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "candidatesTokenCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "promptTokenCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "totalTokenCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}