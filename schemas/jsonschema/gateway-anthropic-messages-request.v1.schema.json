{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewayAnthropicMessagesRequest",
  "type": "object",
  "required": [
    "messages",
    "model"
  ],
  "properties": {
    "max_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GatewayAnthropicMessage"
      }
    },
    "model": {
      "type": "string"
    },
    "stream": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "system": {
      "type": [
        "string",
        "null"
      ]
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "top_k": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "minimum": 0.0
    },
    "top_p": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    }
  },
  "definitions": {
    "GatewayAnthropicMessage": {
      "type": "object",
      "required": [
        "content",
        "role"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/GatewayAnthropicMessageContent"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "GatewayAnthropicMessageContent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GatewayAnthropicMessageContentBlock"
          }
        }
      ]
    },
    "GatewayAnthropicMessageContentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        }
      ]
    }
  }
}