{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewayChatRequest",
  "type": "object",
  "required": [
    "chat",
    "request"
  ],
  "properties": {
    "chat": {
      "$ref": "#/definitions/ChatRequest"
    },
    "request": {
      "$ref": "#/definitions/RequestEnvelope"
    }
  },
  "definitions": {
    "ChatMessage": {
      "type": "object",
      "required": [
        "content",
        "role"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/ChatMessageRole"
        }
      }
    },
    "ChatMessageRole": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "ChatRequest": {
      "type": "object",
      "required": [
        "expected_prompt_tokens",
        "max_output_tokens",
        "messages",
        "model_alias",
        "required_capabilities",
        "temperature_milli",
        "tools"
      ],
      "properties": {
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_prompt_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChatMessage"
          }
        },
        "model_alias": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature_milli": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolDefinition"
          }
        }
      }
    },
    "ProjectId": {
      "type": "string"
    },
    "ProtocolFamily": {
      "type": "string",
      "enum": [
        "openai_chat",
        "openai_responses",
        "mcp_streamable_http",
        "realtime_webrtc"
      ]
    },
    "RequestEnvelope": {
      "type": "object",
      "required": [
        "project_id",
        "protocol_family",
        "request_id",
        "source_service",
        "tenant_id",
        "trace_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/definitions/ProjectId"
        },
        "protocol_family": {
          "$ref": "#/definitions/ProtocolFamily"
        },
        "request_id": {
          "type": "string"
        },
        "source_service": {
          "$ref": "#/definitions/ServiceName"
        },
        "tenant_id": {
          "$ref": "#/definitions/TenantId"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "ServiceName": {
      "type": "string"
    },
    "TenantId": {
      "type": "string"
    },
    "ToolDefinition": {
      "type": "object",
      "required": [
        "description",
        "name"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}