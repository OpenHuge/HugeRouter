{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatRequest",
  "type": "object",
  "required": [
    "expected_prompt_tokens",
    "max_output_tokens",
    "messages",
    "model_alias",
    "required_capabilities",
    "temperature_milli",
    "tools"
  ],
  "properties": {
    "conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_prompt_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "max_output_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChatMessage"
      }
    },
    "model_alias": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temperature_milli": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ToolDefinition"
      }
    }
  },
  "definitions": {
    "ChatMessage": {
      "type": "object",
      "required": [
        "content",
        "role"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/ChatMessageRole"
        }
      }
    },
    "ChatMessageRole": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "ToolDefinition": {
      "type": "object",
      "required": [
        "description",
        "name"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}