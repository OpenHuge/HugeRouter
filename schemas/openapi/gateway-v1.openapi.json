{
  "openapi": "3.1.0",
  "info": {
    "title": "HugeRouter Gateway API",
    "description": "Stable gateway contracts for chat routing and normalized failures.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "v1"
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "tags": [
          "gateway"
        ],
        "operationId": "gateway_chat_completion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chat routed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "tags": [
          "gateway"
        ],
        "operationId": "gateway_anthropic_messages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayAnthropicMessagesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Anthropic messages routed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAnthropicMessagesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAnthropicMessagesError"
                }
              }
            }
          }
        }
      }
    },
    "/v1beta/models/{model}:generateContent": {
      "post": {
        "tags": [
          "gateway"
        ],
        "operationId": "gateway_gemini_generate_content",
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "description": "Gemini model name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayGeminiGenerateContentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Gemini generate-content routed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayGeminiGenerateContentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayGeminiGenerateContentError"
                }
              }
            }
          }
        }
      }
    }
  },
