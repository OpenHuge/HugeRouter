# syntax=docker/dockerfile:1.7
ARG RUST_VERSION=1.94.1

FROM rust:${RUST_VERSION}-bookworm AS builder

ARG SERVICE_NAME
ARG BIN_NAME

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY services ./services

ARG CARGO_REGISTRY_SPARSE_URL
ENV RUSTUP_TOOLCHAIN=${RUST_VERSION}-x86_64-unknown-linux-gnu
RUN if [ -n "${CARGO_REGISTRY_SPARSE_URL}" ]; then \
        mkdir -p .cargo \
        && printf '[source.crates-io]\nreplace-with = "deployment-sparse"\n\n[source.deployment-sparse]\nregistry = "%s"\n' "${CARGO_REGISTRY_SPARSE_URL}" > .cargo/config.toml; \
    fi

RUN --mount=type=cache,id=huge-router-${SERVICE_NAME}-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=huge-router-${SERVICE_NAME}-target,target=/workspace/target,sharing=locked \
    cargo build --locked --release --package "${SERVICE_NAME}" --bin "${BIN_NAME}" \
    && mkdir -p /workspace/build-output \
    && cp "/workspace/target/release/${BIN_NAME}" "/workspace/build-output/${BIN_NAME}"

FROM debian:bookworm-slim AS runtime

ARG BIN_NAME

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /workspace/build-output/${BIN_NAME} /usr/local/bin/service

ENV RUST_LOG=info

ENTRYPOINT ["/usr/local/bin/service"]
